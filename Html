<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Треки по жанрам</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
        body {
            background: #050505;
            color: #fff;
            min-height: 100vh;
            overflow-x: hidden;
            padding: 20px 0 40px;
            position: relative;
        }

        /* ===== МНОГОСПОТНЫЙ ФОН (несколько наложенных пятен) ===== */
        #background-spots {
            position: fixed;
            inset: 0;
            z-index: 0;
            pointer-events: none;
            overflow: visible;
            mix-blend-mode: screen;
        }

        .spot {
            position: absolute;
            border-radius: 50%;
            pointer-events: none;
            filter: blur(48px) saturate(120%);
            will-change: transform, width, height, border-radius, background, opacity, filter;
            mix-blend-mode: screen;
            opacity: 0.95;
        }

        /* индивидуальные пятна с разными размерами и позициями */
        .s1 { width: 44vmin; height: 44vmin; left: 50%; top: 28%; transform: translate(-50%, -28%); }
        .s2 { width: 36vmin; height: 36vmin; left: 40%; top: 36%; transform: translate(-50%, -50%); filter: blur(72px) saturate(130%); }
        .s3 { width: 34vmin; height: 34vmin; left: 62%; top: 34%; transform: translate(-50%, -50%); filter: blur(80px) saturate(120%); }
        .s4 { width: 58vmin; height: 58vmin; left: 52%; top: 42%; transform: translate(-50%, -50%); filter: blur(110px) saturate(120%); opacity:0.85 }
        .s5 { width: 28vmin; height: 28vmin; left: 30%; top: 25%; transform: translate(-50%, -50%); filter: blur(60px) saturate(130%); opacity:0.9 }
        .s6 { width: 30vmin; height: 30vmin; left: 70%; top: 48%; transform: translate(-50%, -50%); filter: blur(64px) saturate(120%); opacity:0.9 }

        /* Каждый слой — радиальные градиенты, цвета назначаются в JS через CSS-переменные */
        .s1 { background: radial-gradient(circle at 45% 40%, var(--c1-inner, rgba(255,200,120,1)) 0%, var(--c1, rgba(255,140,60,1)) 35%, rgba(0,0,0,0) 75%); }
        .s2 { background: radial-gradient(circle at 60% 20%, var(--c2-inner, rgba(255,90,140,0.95)) 0%, var(--c2, rgba(200,60,140,0.9)) 35%, rgba(0,0,0,0) 80%); }
        .s3 { background: radial-gradient(circle at 30% 70%, var(--c3-inner, rgba(120,220,120,0.95)) 0%, var(--c3, rgba(40,200,120,0.9)) 35%, rgba(0,0,0,0) 80%); }
        .s4 { background: radial-gradient(circle at 50% 50%, var(--c4-inner, rgba(255,230,120,0.95)) 0%, var(--c4, rgba(255,170,40,0.95)) 30%, rgba(0,0,0,0) 70%); }
        .s5 { background: radial-gradient(circle at 20% 30%, var(--c5-inner, rgba(200,60,200,0.9)) 0%, var(--c5, rgba(180,40,160,0.85)) 35%, rgba(0,0,0,0) 80%); }
        .s6 { background: radial-gradient(circle at 80% 60%, var(--c6-inner, rgba(255,180,80,0.9)) 0%, var(--c6, rgba(255,100,40,0.9)) 35%, rgba(0,0,0,0) 80%); }

        /* Морфинг форм через border-radius + небольшие перемещения */
        @keyframes morph1 {
            0% { transform: translate(-50%, -28%) scale(1); border-radius: 48% 52% 45% 55% / 52% 45% 55% 48%; }
            25% { transform: translate(-42%, -34%) scale(1.03); border-radius: 42% 58% 40% 60% / 50% 42% 58% 50%; }
            50% { transform: translate(-58%, -24%) scale(0.97); border-radius: 55% 45% 60% 40% / 44% 60% 40% 56%; }
            75% { transform: translate(-50%, -30%) scale(1.02); border-radius: 50% 50% 45% 55% / 48% 50% 55% 47%; }
            100% { transform: translate(-50%, -28%) scale(1); border-radius: 48% 52% 45% 55% / 52% 45% 55% 48%; }
        }
        @keyframes morph2 {
            0% { transform: translate(-50%, -50%) scale(1); border-radius: 45% 55% 50% 50% / 50% 48% 52% 50%; }
            25% { transform: translate(-60%, -44%) scale(1.05); border-radius: 60% 40% 45% 55% / 40% 60% 50% 50%; }
            50% { transform: translate(-42%, -56%) scale(0.96); border-radius: 50% 50% 55% 45% / 55% 50% 45% 50%; }
            75% { transform: translate(-48%, -52%) scale(1.02); border-radius: 46% 54% 50% 50% / 48% 52% 50% 50%; }
            100% { transform: translate(-50%, -50%) scale(1); border-radius: 45% 55% 50% 50% / 50% 48% 52% 50%; }
        }
        @keyframes morph3 {
            0% { transform: translate(-50%, -50%) scale(1); border-radius: 50% 50% 48% 52% / 50% 52% 48% 50%; }
            25% { transform: translate(-44%, -44%) scale(1.04); border-radius: 42% 58% 60% 40% / 60% 40% 50% 50%; }
            50% { transform: translate(-58%, -54%) scale(0.98); border-radius: 55% 45% 50% 50% / 50% 45% 55% 50%; }
            75% { transform: translate(-50%, -48%) scale(1.01); border-radius: 52% 48% 55% 45% / 48% 50% 52% 50%; }
            100% { transform: translate(-50%, -50%) scale(1); border-radius: 50% 50% 48% 52% / 50% 52% 48% 50%; }
        }
        @keyframes morph4 {
            0% { transform: translate(-50%, -50%) scale(1); border-radius: 40% 60% 50% 50% / 50% 40% 60% 50%; }
            25% { transform: translate(-52%, -46%) scale(1.02); border-radius: 60% 40% 55% 45% / 40% 60% 50% 50%; }
            50% { transform: translate(-48%, -54%) scale(0.97); border-radius: 55% 45% 48% 52% / 50% 45% 55% 50%; }
            75% { transform: translate(-50%, -50%) scale(1.01); border-radius: 46% 54% 50% 50% / 48% 52% 50% 50%; }
            100% { transform: translate(-50%, -50%) scale(1); border-radius: 40% 60% 50% 50% / 50% 40% 60% 50%; }
        }
        @keyframes morph5 {
            0% { transform: translate(-50%, -50%) scale(1); border-radius: 52% 48% 45% 55% / 58% 42% 48% 52%; }
            25% { transform: translate(-44%, -60%) scale(1.03); border-radius: 48% 52% 55% 45% / 50% 58% 42% 50%; }
            50% { transform: translate(-56%, -40%) scale(0.97); border-radius: 42% 58% 60% 40% / 44% 60% 40% 56%; }
            75% { transform: translate(-50%, -50%) scale(1.02); border-radius: 50% 50% 45% 55% / 48% 50% 55% 47%; }
            100% { transform: translate(-50%, -50%) scale(1); border-radius: 52% 48% 45% 55% / 58% 42% 48% 52%; }
        }
        @keyframes morph6 {
            0% { transform: translate(-50%, -50%) scale(1); border-radius: 45% 55% 50% 50% / 50% 48% 52% 50%; }
            25% { transform: translate(-60%, -52%) scale(1.04); border-radius: 60% 40% 45% 55% / 40% 60% 50% 50%; }
            50% { transform: translate(-42%, -46%) scale(0.98); border-radius: 50% 50% 55% 45% / 55% 50% 45% 50%; }
            75% { transform: translate(-50%, -48%) scale(1.01); border-radius: 46% 54% 50% 50% / 48% 52% 50% 50%; }
            100% { transform: translate(-50%, -50%) scale(1); border-radius: 45% 55% 50% 50% / 50% 48% 52% 50%; }
        }

        .s1 { animation: morph1 10s ease-in-out infinite; }
        .s2 { animation: morph2 12s ease-in-out infinite; animation-delay: 1.2s; }
        .s3 { animation: morph3 14s ease-in-out infinite; animation-delay: 0.6s; }
        .s4 { animation: morph4 18s ease-in-out infinite; animation-delay: 0.9s; }
        .s5 { animation: morph5 11s ease-in-out infinite; animation-delay: 0.4s; }
        .s6 { animation: morph6 13s ease-in-out infinite; animation-delay: 1.0s; }

        /* небольшой центральный свет */
        #background-spots::after {
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
            z-index: 0;
            background: radial-gradient(30% 25% at 50% 32%, rgba(255,210,130,0.06), transparent 25%);
        }

        /* ===== КОНТЕНТ ===== */
        .page-header { padding: 0 20px 6px; position: relative; z-index: 2; }
        .page-title { font-size: 28px; font-weight: 800; letter-spacing: -0.5px; color: #fff; }

        .genre-list { display: flex; gap: 14px; overflow-x: auto; padding: 16px 20px 12px; scrollbar-width: none; -webkit-overflow-scrolling: touch; scroll-behavior: smooth; position: relative; z-index: 2; -ms-overflow-style: none; }
        .genre-list::-webkit-scrollbar { display: none; }

        .genre-item { background: transparent; color: #fff; opacity: 0.5; border: 1px solid rgba(255,255,255,0.2); padding: 10px 24px; border-radius: 50px; font-size: 14px; font-weight: 700; white-space: nowrap; transition: all 0.3s ease; cursor: pointer; flex-shrink: 0; background: rgba(255,255,255,0.05); backdrop-filter: blur(4px); user-select: none; }
        .genre-item.active { opacity: 1; border-color: var(--spot-color, #FF3B30); background: rgba(255,255,255,0.1); transform: scale(1.05); box-shadow: 0 0 20px var(--spot-color, #FF3B30); }

        .music-container { display: flex; gap: 24px; overflow-x: auto; padding: 10px 15px 30px 15px; scroll-behavior: smooth; scrollbar-width: none; -webkit-overflow-scrolling: touch; scroll-snap-type: x mandatory; cursor: grab; user-select: none; position: relative; z-index: 2; scroll-padding: 0; -ms-overflow-style: none; }
        .music-container::-webkit-scrollbar { display: none; }

        .tracks-column-genre { display: flex; flex-direction: column; gap: 12px; width: 340px; min-width: 340px; flex-shrink: 0; scroll-snap-align: start; }

        .genre-track-item { display: flex; align-items: center; gap: 14px; cursor: pointer; padding: 6px 0; border-radius: 12px; background: transparent; border: none; }

        .track-cover-wrapper { position: relative; width: 62px; height: 62px; flex-shrink: 0; }
        .track-cover { width: 100%; height: 100%; border-radius: 8px; object-fit: cover; transition: filter 0.3s ease; }
        .genre-track-item.is-playing .track-cover { filter: brightness(0.4); }
        .playing-indicator { position: absolute; top: 0; left: 0; width: 100%; height: 100%; display:flex; justify-content:center; align-items:center; gap:4px; border-radius:8px; opacity:0; transition: opacity 0.3s ease; background: rgba(0,0,0,0.2); }
        .genre-track-item.is-playing .playing-indicator { opacity: 1; }
        .playing-indicator .bar { width:4px; height:20%; background-color:#fff; border-radius:2px; }
        @keyframes play-anim { 0%,100%{transform:scaleY(0.5);}50%{transform:scaleY(1.5);} }
        .genre-track-item.is-playing .bar { animation: play-anim 1.2s ease-in-out infinite; }
        .genre-track-item.is-playing .bar:nth-child(2) { animation-delay: 0.2s; }
        .genre-track-item.is-playing .bar:nth-child(3) { animation-delay: 0.4s; }
        .genre-track-item.is-playing .bar:nth-child(4) { animation-delay: 0.1s; }

        .track-info { flex: 1; min-width: 0; }
        .track-name { font-size: 16px; font-weight: 700; margin-bottom: 3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: #fff; }
        .track-meta { font-size: 13px; color: #b3b3b3; display:flex; align-items:center; gap:6px; }

        .genre-track-options { color: rgba(255,255,255,0.5); font-size: 20px; padding: 0 10px 0 30px; cursor: pointer; transition: color 0.2s ease; background: transparent; border: none; font-weight: 600; letter-spacing: 2px; line-height: 1; display:inline-flex; align-items:center; justify-content:center; margin-left:auto; }
        .genre-track-options:hover { color: rgba(255,255,255,0.8); }
    </style>
</head>
<body>

    <div id="background-spots">
        <div class="spot s4" id="s4"></div>
        <div class="spot s1" id="s1"></div>
        <div class="spot s2" id="s2"></div>
        <div class="spot s3" id="s3"></div>
        <div class="spot s5" id="s5"></div>
        <div class="spot s6" id="s6"></div>
    </div>

    <div class="page-header">
        <div class="page-title">Треки по жанрам</div>
    </div>

    <div class="genre-list" id="genreList">
        <button class="genre-item active" data-color="#FF3B30">Рок</button>
        <button class="genre-item" data-color="#9D00FF">Фонк</button>
        <button class="genre-item" data-color="#00A86B">Фолк</button>
        <button class="genre-item" data-color="#007AFF">Хип-хоп</button>
        <button class="genre-item" data-color="#FF2D55">Поп</button>
        <button class="genre-item" data-color="#FF9500">Джаз</button>
        <button class="genre-item" data-color="#32D74B">Инди</button>
        <button class="genre-item" data-color="#AF52DE">Метал</button>
        <button class="genre-item" data-color="#5AC8FA">Электроника</button>
        <button class="genre-item" data-color="#FFCC00">R&B</button>
        <button class="genre-item" data-color="#8E8E93">Лоу-фай</button>
    </div>

    <div class="music-container" id="musicContainer"></div>

    <script>
        // данные как раньше (сокращены встраиваем)
        const testImages = [
            'https://picsum.photos/id/100/400/400', 'https://picsum.photos/id/101/400/400', 'https://picsum.photos/id/102/400/400',
            'https://picsum.photos/id/103/400/400', 'https://picsum.photos/id/104/400/400', 'https://picsum.photos/id/105/400/400'
        ];
        const musicData = {
            "Рок":[{n:"ПОСЛЕДНИЙ NOTHING",a:"Toxi$, MORGENSHTERN",img:testImages[0]},{n:"ПОД КОЖУ",a:"Райни",img:testImages[1]},{n:"ТЫ НИЧЕГО НЕ ПОНЯЛА",a:"choldd",img:testImages[2]},{n:"NUMB",a:"Linkin Park",img:testImages[3]},{n:"DU HAST",a:"Rammstein",img:testImages[4]},{n:"SMELLS LIKE",a:"Nirvana",img:testImages[5]}],
            "Фонк":[{n:"MURDER IN MY MIND",a:"Kordhell",img:testImages[0]},{n:"SAHARA",a:"Hensonn",img:testImages[1]},{n:"METAMORPHOSIS",a:"INTERWORLD",img:testImages[2]},{n:"OVERRIDE",a:"KSLV Noh",img:testImages[3]},{n:"AVALON",a:"$uicideboy$",img:testImages[4]},{n:"SCARY GARY",a:"Kaito Shoma",img:testImages[5]}],
            "Фолк":[{n:"КАЛИНКА",a:"Иван Купала",img:testImages[0]},{n:"ВО ПОЛЕ БЕРЕЗА",a:"Пелагея",img:testImages[1]},{n:"ОЙ, ТО НЕ ВЕЧЕР",a:"Мельница",img:testImages[2]},{n:"КОНЬ",a:"Любэ",img:testImages[3]},{n:"ЧЁРНЫЙ ВОРОН",a:"Алиса",img:testImages[4]},{n:"ТРАВА У ДОМА",a:"Земляне",img:testImages[5]}],
            "Хип-хоп":[{n:"GODZILLA",a:"Eminem",img:testImages[0]},{n:"SICKO MODE",a:"Travis Scott",img:testImages[1]},{n:"HUMBLE",a:"Kendrick Lamar",img:testImages[2]},{n:"STARBOY",a:"The Weeknd",img:testImages[3]},{n:"INDUSTRY BABY",a:"Lil Nas X",img:testImages[4]},{n:"MONTERO",a:"Lil Nas X",img:testImages[5]}],
            "Поп":[{n:"BLINDING LIGHTS",a:"The Weeknd",img:testImages[0]},{n:"LEVITATING",a:"Dua Lipa",img:testImages[1]},{n:"BAD GUY",a:"Billie Eilish",img:testImages[2]},{n:"DRIVERS LICENSE",a:"Olivia Rodrigo",img:testImages[3]},{n:"AS IT WAS",a:"Harry Styles",img:testImages[4]},{n:"SHAPE OF YOU",a:"Ed Sheeran",img:testImages[5]}],
            "Джаз":[{n:"TAKE FIVE",a:"Dave Brubeck",img:testImages[0]},{n:"SO WHAT",a:"Miles Davis",img:testImages[1]},{n:"FEELING GOOD",a:"Nina Simone",img:testImages[2]},{n:"FLY ME TO THE MOON",a:"Frank Sinatra",img:testImages[3]},{n:"MY FUNNY VALENTINE",a:"Chet Baker",img:testImages[4]},{n:"AUTUMN LEAVES",a:"Bill Evans",img:testImages[5]}],
            "Инди":[{n:"DOG DAYS ARE OVER",a:"Florence + The Machine",img:testImages[0]},{n:"HOLOCENE",a:"Bon Iver",img:testImages[1]},{n:"ELECTRIC FEEL",a:"MGMT",img:testImages[2]},{n:"WEIGHTY GHOST",a:"Westerman",img:testImages[3]},{n:"APOCALYPSE",a:"Cigarettes After Sex",img:testImages[4]},{n:"SWEET",a:"Cigarettes After Sex",img:testImages[5]}],
            "Метал":[{n:"MASTER OF PUPPETS",a:"Metallica",img:testImages[0]},{n:"PARANOID",a:"Black Sabbath",img:testImages[1]},{n:"HALLOWED BE THY NAME",a:"Iron Maiden",img:testImages[2]},{n:"PAIN KILLER",a:"Judas Priest",img:testImages[3]},{n:"RAINING BLOOD",a:"Slayer",img:testImages[4]},{n:"DUALITY",a:"Slipknot",img:testImages[5]}],
            "Электроника":[{n:"STROBE",a:"deadmau5",img:testImages[0]},{n:"OPUS",a:"Eric Prydz",img:testImages[1]},{n:"ANIMALS",a:"Martin Garrix",img:testImages[2]},{n:"LEVELS",a:"Avicii",img:testImages[3]},{n:"SANDSTORM",a:"Darude",img:testImages[4]},{n:"CLARITY",a:"Zedd",img:testImages[5]}],
            "R&B":[{n:"BLAME IT",a:"Jamie Foxx",img:testImages[0]},{n:"ORDINARY PEOPLE",a:"John Legend",img:testImages[1]},{n:"UMBRELLA",a:"Rihanna",img:testImages[2]},{n:"NO ONE",a:"Alicia Keys",img:testImages[3]},{n:"WE BELONG TOGETHER",a:"Mariah Carey",img:testImages[4]},{n:"IRREPLACEABLE",a:"Beyoncé",img:testImages[5]}],
            "Лоу-фай":[{n:"SNOWFALL",a:"Øneheart",img:testImages[0]},{n:"LOFI HIP HOP BEATS",a:"Chillhop",img:testImages[1]},{n:"STUDY BEATS",a:"Lofi Girl",img:testImages[2]},{n:"RAINY NIGHT",a:"Lofi Fruits",img:testImages[3]},{n:"DREAMS",a:"Lofi Fruits",img:testImages[4]},{n:"MEMORIES",a:"Lofi Fruits",img:testImages[5]}]
        };

        // state
        let currentPlayingTrackId = null;
        let activeGenre = 'Рок';

        // spot elements
        const spots = [document.getElementById('s1'), document.getElementById('s2'), document.getElementById('s3'), document.getElementById('s4'), document.getElementById('s5'), document.getElementById('s6')];

        // helper: hex <-> hsl conversions
        function hexToRgb(hex) {
            const h = hex.replace('#','');
            const bigint = parseInt(h,16);
            return { r: (bigint>>16)&255, g:(bigint>>8)&255, b: bigint&255 };
        }
        function rgbToHsl(r,g,b) {
            r/=255; g/=255; b/=255;
            const max = Math.max(r,g,b), min = Math.min(r,g,b);
            let h,s,l = (max+min)/2;
            if(max===min){h=s=0;} else {
                const d = max-min;
                s = l>0.5? d/(2-max-min) : d/(max+min);
                switch(max){ case r: h = (g-b)/d + (g<b?6:0); break; case g: h = (b-r)/d + 2; break; default: h = (r-g)/d +4; }
                h /= 6;
            }
            return { h: Math.round(h*360), s: Math.round(s*100), l: Math.round(l*100) };
        }
        function hslToCss(h,s,l,a=1){ return `hsla(${h}, ${s}%, ${l}%, ${a})`; }

        // generate warm/cool variants from main color
        function makePalette(hex){
            const rgb = hexToRgb(hex); const hsl = rgbToHsl(rgb.r,rgb.g,rgb.b);
            const baseH = hsl.h, baseS = hsl.s, baseL = hsl.l;
            // create 6 variants by shifting hue and changing lightness
            return [
                {h: (baseH+0)%360, s: Math.min(100, baseS+10), l: Math.min(80, baseL+10)},
                {h: (baseH+28)%360, s: Math.min(100, baseS+5), l: Math.min(75, baseL+5)},
                {h: (baseH-40+360)%360, s: Math.min(100, baseS+15), l: Math.max(35, baseL-5)},
                {h: (baseH+6)%360, s: Math.min(100, baseS+20), l: Math.min(70, baseL+12)},
                {h: (baseH+200)%360, s: Math.min(100, baseS+5), l: Math.min(65, baseL+10)},
                {h: (baseH+50)%360, s: Math.min(100, baseS+8), l: Math.min(60, baseL+8)}
            ].map(x => hslToCss(x.h,x.s,x.l,0.95));
        }

        // apply palette to spot backgrounds (inner & main stops)
        function applyMultiSpots(hex) {
            const pal = makePalette(hex);
            // assign CSS backgrounds for spots (using two stops each: inner lighter + main)
            spots[0].style.background = `radial-gradient(circle at 48% 42%, ${pal[0]} 0%, ${pal[1]} 35%, rgba(0,0,0,0) 75%)`;
            spots[1].style.background = `radial-gradient(circle at 60% 28%, ${pal[2]} 0%, ${pal[0]} 30%, rgba(0,0,0,0) 78%)`;
            spots[2].style.background = `radial-gradient(circle at 32% 68%, ${pal[3]} 0%, ${pal[2]} 34%, rgba(0,0,0,0) 80%)`;
            spots[3].style.background = `radial-gradient(circle at 50% 50%, ${pal[1]} 0%, ${pal[4]} 30%, rgba(0,0,0,0) 70%)`;
            spots[4].style.background = `radial-gradient(circle at 22% 30%, ${pal[5]} 0%, ${pal[0]} 36%, rgba(0,0,0,0) 82%)`;
            spots[5].style.background = `radial-gradient(circle at 82% 62%, ${pal[0]} 0%, ${pal[1]} 34%, rgba(0,0,0,0) 80%)`;

            // slightly vary blur/opacity based on colors to keep natural look
            spots.forEach((el,i)=>{
                const o = 0.82 + (i%3)*0.05;
                el.style.opacity = o;
            });
        }

        // ===== переключение режимов =====
        function setNeutralMode(){
            // multicenter warm default like screenshot
            applyMultiSpots('#FFB04A');
            document.documentElement.style.removeProperty('--spot-color');
        }
        function setGenreMode(color){
            applyMultiSpots(color);
            document.documentElement.style.setProperty('--spot-color', color);
        }

        // ===== render tracks (как раньше) =====
        function renderGenreTracks(genre){
            const musicContainer = document.getElementById('musicContainer');
            musicContainer.innerHTML = '';
            const tracks = musicData[genre] || [];
            if(tracks.length===0){ musicContainer.innerHTML = '<div style="color: rgba(255,255,255,0.3); padding: 20px;">Нет треков</div>'; return; }
            const tracksPerColumn = 3;
            const columnCount = Math.ceil(tracks.length / tracksPerColumn);
            for(let colIndex=0; colIndex<columnCount; colIndex++){
                const column = document.createElement('div'); column.className='tracks-column-genre';
                const start = colIndex*tracksPerColumn; const end = Math.min(start+tracksPerColumn, tracks.length);
                const columnTracks = tracks.slice(start,end);
                columnTracks.forEach(t=>{
                    const trackElem = document.createElement('div'); trackElem.className='genre-track-item'; trackElem.dataset.trackName = t.n;
                    const coverWrapper = document.createElement('div'); coverWrapper.className='track-cover-wrapper';
                    coverWrapper.innerHTML = `<img src="${t.img}" class="track-cover" alt="${t.n}"><div class="playing-indicator"><div class="bar"></div><div class="bar"></div><div class="bar"></div><div class="bar"></div></div>`;
                    const trackInfo = document.createElement('div'); trackInfo.className='track-info'; trackInfo.innerHTML = `<div class="track-name">${escapeHtml(t.n)}</div><div class="track-meta">${escapeHtml(t.a)}</div>`;
                    const optionsBtn = document.createElement('button'); optionsBtn.className='genre-track-options'; optionsBtn.textContent='⋯'; optionsBtn.onclick = (e)=>{ e.stopPropagation(); console.log(`Действие для трека "${t.n}"`); };
                    trackElem.appendChild(coverWrapper); trackElem.appendChild(trackInfo); trackElem.appendChild(optionsBtn);
                    trackElem.addEventListener('click', function(){ document.querySelectorAll('.genre-track-item').forEach(el=>el.classList.remove('is-playing')); this.classList.add('is-playing'); currentPlayingTrackId = t.n; console.log(`▶ Воспроизведение: ${t.n} — ${t.a}`); });
                    column.appendChild(trackElem);
                });
                musicContainer.appendChild(column);
            }
            if(currentPlayingTrackId){ document.querySelectorAll('.genre-track-item').forEach(el=>{ const name = el.querySelector('.track-name')?.textContent; if(name===currentPlayingTrackId) el.classList.add('is-playing'); }); }
        }
        function escapeHtml(str){ return String(str).replace(/[&<>]/g, function(m){ if(m==='&') return '&amp;'; if(m==='<') return '&lt;'; if(m==='>') return '&gt;'; return m; }); }

        // ===== переключение жанров =====
        function setupGenreSwitching(){
            const buttons = document.querySelectorAll('.genre-item');
            buttons.forEach(btn=>{
                btn.addEventListener('click', function(){
                    const genreName = this.textContent; const color = this.dataset.color;
                    if(this.classList.contains('active')){ buttons.forEach(b=>b.classList.remove('active')); setNeutralMode(); activeGenre = null; return; }
                    buttons.forEach(b=>b.classList.remove('active')); this.classList.add('active'); setGenreMode(color); activeGenre = genreName; renderGenreTracks(genreName);
                    const btnLeft = this.offsetLeft; const btnWidth = this.offsetWidth; const listWidth = this.parentElement.clientWidth;
                    this.parentElement.scrollTo({ left: btnLeft - listWidth/2 + btnWidth/2, behavior: 'smooth' });
                    document.getElementById('musicContainer').scrollTo({ left: 0, behavior: 'smooth' });
                });
            });
        }

        // init
        document.addEventListener('DOMContentLoaded', ()=>{
            const defaultGenre = 'Рок'; const defaultColor = '#FF3B30';
            setGenreMode(defaultColor);
            renderGenreTracks(defaultGenre);
            setupGenreSwitching();
        });
    </script>
</body>
</html>
